{
  "champion_name": "Dynamic Oracle Champion Ensemble (Round 1)",
  "champion_accuracy": 0.6013731825525040,
  "champion_correct": 5956,
  "test_set_size": 9904,
  "verified_date": "2026-08-15",

  "feature_pipeline": {
    "module": "src.optimization.features",
    "function": "build_advanced_feature_matrix",
    "n_features": 217,
    "description": "Round 1 advanced features: Elo-based, form windows, Dixon-Coles probabilities, head-to-head, venue, competition context"
  },

  "base_models": {
    "LightGBM": {
      "module": "src.optimization.models",
      "factory_name": "lightgbm",
      "params": {
        "n_estimators": 300,
        "learning_rate": 0.04,
        "max_depth": 4,
        "num_leaves": 15,
        "min_child_samples": 30,
        "subsample": 0.8,
        "colsample_bytree": 0.8,
        "reg_alpha": 0.5,
        "reg_lambda": 1.0,
        "random_state": 42
      }
    },
    "XGBoost": {
      "module": "src.optimization.models",
      "factory_name": "xgboost",
      "params": {
        "n_estimators": 300,
        "learning_rate": 0.04,
        "max_depth": 4,
        "subsample": 0.8,
        "colsample_bytree": 0.8,
        "reg_alpha": 0.5,
        "reg_lambda": 1.0,
        "random_state": 42
      }
    },
    "CatBoost": {
      "module": "src.optimization.models",
      "factory_name": "catboost",
      "params": {
        "iterations": 300,
        "learning_rate": 0.05,
        "depth": 4,
        "l2_leaf_reg": 3.0,
        "random_seed": 42
      }
    },
    "HistGBDT": {
      "module": "src.optimization.models",
      "factory_name": "hist_gbdt",
      "params": {
        "max_iter": 300,
        "learning_rate": 0.05,
        "max_depth": 4,
        "min_samples_leaf": 30,
        "l2_regularization": 1.0,
        "random_state": 42
      }
    },
    "DixonColes": {
      "description": "Dixon-Coles bivariate Poisson model (integrated in feature pipeline)",
      "note": "Probabilities generated by _bivariate_poisson_probs in src.optimization.features"
    }
  },

  "ensemble": {
    "method": "log_loss_optimized_convex_combination",
    "module": "src.optimization.ensemble",
    "function": "optimize_ensemble_weights",
    "loss_type": "log_loss",
    "note": "Weights are optimized on validation folds via SLSQP, then applied to test predictions. Exact weights vary per temporal fold but approximate: LightGBM ~30%, XGBoost ~25%, CatBoost ~17%, HistGBDT ~21%, DixonColes ~6.5%"
  },

  "data": {
    "source": "data/raw/results.csv",
    "total_matches": 49520,
    "test_matches": 9904,
    "split_method": "rolling_origin_temporal",
    "n_folds": 4,
    "module": "src.data.split"
  },

  "evaluation": {
    "module": "src.evaluation.metrics",
