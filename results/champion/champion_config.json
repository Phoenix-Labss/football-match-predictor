      "normalized_rps": 0.16958174400886017,
      "brier_score": 0.5111677453872154,
      "ece": 0.014325607805993495
    }
  },

  "pipeline_entry_point": "src.optimization.pipeline",
  "main_function": "run() in pipeline.py (called via python -m src.optimization.pipeline)"
}
